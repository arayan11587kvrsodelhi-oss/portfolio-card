# ── Database ─────────────────
# PostgreSQL connection string used by Prisma (server-only, never exposed to client).
# Local example: postgresql://USER:PASSWORD@localhost:5432/portfolio_card
DATABASE_URL=

# ── Public site config ───────────────────────
# Public base URL of the deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
